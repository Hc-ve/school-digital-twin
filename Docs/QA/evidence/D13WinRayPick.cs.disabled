#if UNITY_EDITOR
using System;
using System.Collections.Generic;
using System.IO;
using System.Linq;
using System.Text;
using UnityEditor;
using UnityEditor.SceneManagement;
using UnityEngine;

namespace SchoolTwin.EditorTools
{
    /// <summary>
    /// 【D13WIN-RAY】黑条真身射线拾取 —— 一次问清黑条到底属于哪个物体。
    ///
    /// ── 为什么必须做这一步 ─────────────────────────────────────────
    /// 已排除的假设：
    ///   ✗ 方向光图      — 黑/亮纹素在 _comp_dir 里方向值几乎相同（0.500 vs 0.500）
    ///   ✗ mask 定位错   — R1 mask内<0.05 染红，屏幕上 3/4 条黑条变红
    ///   ✗ 洞没补上      — 洞内 10715 个已补到 0.10~0.20 单色，屏幕上黑块仍在
    ///   ✗ mask 内没补   — mask 内 8120 个也已补完，剩 0 个 <0.05
    ///   ✗ Unity 编码毁图 — 已改用 Python 纯 EXR 读写，逐位无损
    /// 也就是说：把 Windows1~5 的 UV 范围内【所有】黑纹素都填亮了，
    /// 屏幕上黑块依然存在 ⇒ 黑块采样的纹素不在这些 mask 里，甚至可能不属于这些物体。
    ///
    /// ── 做法 ───────────────────────────────────────────────────────
    /// 从窗框机位渲染一张图，找出屏幕上亮度 <0.05 的像素，
    /// 对这些像素做 Physics.Raycast（不考虑法线，双向），读出：
    ///   命中物体路径 / mesh 名 / 材质名 / lightmapIndex / lightmapScaleOffset /
    ///   命中点的 UV0 与 UV2 / UV2 换算成的图集纹素坐标 /
    ///   该纹素在 lightmapColor 与 lightmapDir 中的实际值
    /// ⇒ 直接看到「黑块对应的到底是哪个纹素、哪张图、值多少」。
    ///
    /// 菜单：归档 → D13-WIN ⑥ 黑条射线拾取（只读，不改任何资产）
    /// </summary>
    public static class D13WinRayPick
    {
        const string ScenePath = "Assets/TirGames/SchoolScene/Scenes/SchoolSceneDay.unity";
        const string EvDir = "Docs/QA/evidence";
        const string LogName = "D13WIN_raypick.txt";

        static string Root => Directory.GetCurrentDirectory();
        static string Abs(string rel) => Path.Combine(Root, rel);
        static float Lum(Color c) => 0.299f * c.r + 0.587f * c.g + 0.114f * c.b;

        struct Shot { public Vector3 pos, look; public string tag; }

        [MenuItem("归档/D13-WIN ⑥ 黑条射线拾取（只读，不改资产）", false, 156)]
        public static void Run()
        {
            var log = new StringBuilder();
            void L(string m) { log.AppendLine(m); Debug.Log("[D13RAY] " + m); }

            try
            {
                if (EditorApplication.isPlaying) { L("❌ 请先退出 Play 模式再执行"); return; }
                if (!File.Exists(Abs(ScenePath))) { L("场景不存在: " + ScenePath); return; }
                Directory.CreateDirectory(Abs(EvDir));

                var scene = UnityEngine.SceneManagement.SceneManager.GetActiveScene();
                if (!scene.IsValid() || !string.Equals(scene.path, ScenePath, StringComparison.Ordinal))
                    scene = EditorSceneManager.OpenScene(ScenePath, OpenSceneMode.Single);
                DynamicGI.UpdateEnvironment();

                var lmData = LightmapSettings.lightmaps;
                L($"# D13WIN 黑条射线拾取  {DateTime.Now:yyyy-MM-dd HH:mm:ss}");
                L($"场景 {ScenePath}");
                L($"lightmap 图集数 = {lmData.Length}");
                L("");

                var shots = new List<Shot>
                {
                    new Shot{ pos=new Vector3( 2.00f,1.85f,30.20f), look=new Vector3( 2.00f,2.00f,28.36f), tag="win_north" },
                    new Shot{ pos=new Vector3(22.60f,1.85f,24.00f), look=new Vector3(24.52f,2.00f,24.00f), tag="win_east"  },
                };

                foreach (var shot in shots)
                {
                    L($"===== 机位 {shot.tag}  pos={shot.pos}  look={shot.look} =====");
                    var camGo = new GameObject("[D13RAYCam]");
                    try
                    {
                        var cam = camGo.AddComponent<Camera>();
                        cam.fieldOfView = 60f;
                        cam.nearClipPlane = 0.05f;
                        cam.farClipPlane = 300f;
                        cam.clearFlags = CameraClearFlags.SolidColor;
                        cam.backgroundColor = new Color(1, 0, 1, 1);
                        cam.transform.position = shot.pos;
                        cam.transform.LookAt(shot.look);

                        const int W = 960, H = 600;
                        var rt = new RenderTexture(W, H, 24, RenderTextureFormat.ARGB32);
                        var prevActive = RenderTexture.active;
                        Color[] px;
                        try
                        {
                            cam.targetTexture = rt;
                            cam.Render();
                            RenderTexture.active = rt;
                            var reader = new Texture2D(W, H, TextureFormat.RGB24, false);
                            reader.ReadPixels(new Rect(0, 0, W, H), 0, 0);
                            reader.Apply();
                            px = reader.GetPixels();
                            UnityEngine.Object.DestroyImmediate(reader);
                        }
                        finally
                        {
                            cam.targetTexture = null;
                            RenderTexture.active = prevActive;
                            UnityEngine.Object.DestroyImmediate(rt);
                        }

                        // 找出屏幕暗像素（排除洋红背景）
                        var darkSamples = new List<(int x, int y, Color c)>();
                        for (int y = 0; y < H; y += 2)          // 隔行采样，够用
                        for (int x = 0; x < W; x += 2)
                        {
                            var c = px[y * W + x];
                            if (c.r > 0.9f && c.g < 0.15f && c.b > 0.9f) continue;  // 背景
                            if (Lum(c) < 0.05f) darkSamples.Add((x, y, c));
                        }
                        L($"  屏幕暗像素(隔行采样) = {darkSamples.Count}");

                        // 聚类成块（简单网格聚类，便于按块报告）
                        var groups = new Dictionary<string, List<(int x, int y, Color c)>>();
                        const int GS = 24;
                        foreach (var s in darkSamples)
                        {
                            string k = (s.x / GS) + "_" + (s.y / GS);
                            if (!groups.TryGetValue(k, out var list)) { list = new List<(int, int, Color)>(); groups[k] = list; }
                            list.Add(s);
                        }
                        var bigGroups = groups.Where(g => g.Value.Count >= 12)
                                              .OrderByDescending(g => g.Value.Count).Take(24).ToList();
                        L($"  暗块组数(≥12采样点) = {bigGroups.Count}");
                        L("");

                        // 对每组中心做射线拾取
                        foreach (var g in bigGroups)
                        {
                            var list = g.Value;
                            int cx = (int)list.Average(v => v.x);
                            int cy = (int)list.Average(v => v.y);
                            int x0 = list.Min(v => v.x), x1 = list.Max(v => v.x);
                            int y0 = list.Min(v => v.y), y1 = list.Max(v => v.y);
                            L($"  --- 暗块 屏幕bbox=({x0},{y0})-({x1},{y1})  采样={list.Count}  中心=({cx},{cy}) ---");

                            var ray = cam.ScreenPointToRay(new Vector3(cx, cy, 0));
                            var hits = Physics.RaycastAll(ray, 300f, ~0, QueryTriggerInteraction.Ignore)
                                              .OrderBy(h => h.distance).ToArray();
                            L($"      RaycastAll 命中 {hits.Length} 个（按距离）");

                            int shown = 0;
                            foreach (var h in hits)
                            {
                                if (h.collider == null) continue;
                                var rend = h.collider.GetComponent<Renderer>();
                                var mf = h.collider.GetComponent<MeshFilter>();
                                var sk = h.collider.GetComponent<SkinnedMeshRenderer>();
                                if (rend == null && sk != null) rend = sk;
                                string path = PathOf(h.collider.transform);
                                L($"      [dist={h.distance:F2}] {path}");
                                if (rend != null)
                                {
                                    L($"          renderer={rend.GetType().Name}  lmIndex={rend.lightmapIndex}  " +
                                      $"lmScaleOffset={rend.lightmapScaleOffset}");
                                    var mats = rend.sharedMaterials;
                                    L($"          materials=[{string.Join(",", mats.Where(m => m != null).Select(m => m.name))}]");
                                }
                                else L("          (无 Renderer)");

                                var mesh = mf != null ? mf.sharedMesh : (sk != null ? sk.sharedMesh : null);
                                if (mesh != null)
                                {
                                    L($"          mesh={mesh.name}  verts={mesh.vertexCount}  " +
                                      $"sub={mesh.subMeshCount}  uv2={(mesh.uv2 != null ? mesh.uv2.Length : 0)}");
                                    // 命中三角形顶点 UV
                                    int tri = h.triangleIndex;
                                    if (tri >= 0 && tri * 3 + 2 < mesh.vertexCount)
                                    {
                                        var uv0 = mesh.uv;
                                        var uv2 = mesh.uv2;
                                        if (uv2 != null && uv2.Length == mesh.vertexCount)
                                        {
                                            Vector2 bary = Barycentric(h.point, mesh, tri);
                                            var u0 = Vector2.Lerp(Vector2.Lerp(uv0[tri * 3], uv0[tri * 3 + 1], bary.x), uv0[tri * 3 + 2], bary.y);
                                            var u2 = Vector2.Lerp(Vector2.Lerp(uv2[tri * 3], uv2[tri * 3 + 1], bary.x), uv2[tri * 3 + 2], bary.y);
                                            L($"          tri={tri}  UV0=({u0.x:F4},{u0.y:F4})  UV2=({u2.x:F4},{u2.y:F4})");
                                            if (rend != null && rend.lightmapIndex >= 0 && rend.lightmapIndex < lmData.Length)
                                            {
                                                var st = rend.lightmapScaleOffset;
                                                var tex = lmData[rend.lightmapIndex].lightmapColor;
                                                if (tex != null)
                                                {
                                                    float tx = (u2.x * st.x + st.z) * tex.width;
                                                    float ty = (u2.y * st.y + st.w) * tex.height;
                                                    L($"          → 图集 lm{rend.lightmapIndex} 纹素=({tx:F1},{ty:F1})  size={tex.width}x{tex.height}");
                                                }
                                            }
                                        }
                                        else L("          (uv2 缺失或长度不符，无法换算)");
                                    }
                                }
                                if (++shown >= 6) { L("          ...（后续命中省略）"); break; }
                            }
                            if (hits.Length == 0)
                            {
                                L("      ⚠ 无碰撞体命中。该暗块可能：1) 无 Collider 2) 在相机近裁剪外 3) 是天空盒/背景");
                            }
                            L("");
                        }
                    }
                    finally
                    {
                        UnityEngine.Object.DestroyImmediate(camGo);
                    }
                }

                L("=== 判读方法 ===");
                L("  若暗块命中的物体不是 Windows1~5 ⇒ 黑条属于别的物体，改那一片才有用");
                L("  若命中的是 WindowsX 但 UV2 换算的纹素不在我们导出的 mask 内 ⇒ mask 导出有遗漏");
                L("  若命中的纹素在 mask 内且当前值已 >0.05 ⇒ 黑不是光图造成的，走材质/法线/背面剔除方向");
                L("  若无任何命中 ⇒ 该暗块可能是 Backface（背面剔除）或不可见几何，需查材质 Cull");
            }
            catch (Exception ex)
            {
                L("❌ 异常: " + ex);
                Debug.LogException(ex);
            }
            finally
            {
                File.WriteAllText(Abs(Path.Combine(EvDir, LogName)), log.ToString(), Encoding.UTF8);
                Debug.Log("[D13RAY] 日志: " + Path.Combine(EvDir, LogName));
            }
        }

        /// <summary>按命中点计算三角形重心坐标（用于插值 UV）</summary>
        static Vector2 Barycentric(Vector3 p, Mesh mesh, int tri)
        {
            var v0 = mesh.vertices[tri * 3];
            var v1 = mesh.vertices[tri * 3 + 1];
            var v2 = mesh.vertices[tri * 3 + 2];
            var e1 = v1 - v0; var e2 = v2 - v0; var e0 = p - v0;
            float d00 = Vector3.Dot(e1, e1), d01 = Vector3.Dot(e1, e2), d11 = Vector3.Dot(e2, e2);
            float d20 = Vector3.Dot(e0, e1), d21 = Vector3.Dot(e0, e2);
            float den = d00 * d11 - d01 * d01;
            if (Mathf.Abs(den) < 1e-9f) return new Vector2(0, 0);
            float a = (d11 * d20 - d01 * d21) / den;
            float b = (d00 * d21 - d01 * d20) / den;
            return new Vector2(a, b);
        }

        static string PathOf(Transform t)
        {
            var parts = new List<string>();
            var cur = t;
            while (cur != null) { parts.Insert(0, cur.name); cur = cur.parent; }
            return string.Join("/", parts);
        }
    }
}
#endif