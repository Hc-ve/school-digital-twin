# ============================================================
# Unity 项目 .gitignore
# 项目：School（数字孪生底座）
# 说明：Library/ 达 1.3GB，必须排除；Assets 下的美术资源
#       不在此忽略，而是交给 Git LFS 管理（见 .gitattributes）
# ============================================================

# ---------- Unity 生成目录（绝不入库）----------
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/

# ---------- Asset Store 工具 ----------
/[Aa]ssets/AssetStoreTools*

# ---------- IDE / 编辑器缓存 ----------
.vs/
.idea/
.vscode/
.gradle/
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# ---------- Unity 生成的元文件 ----------
*.pidb.meta
*.pdb.meta
*.mdb.meta

# ---------- 崩溃报告 ----------
sysinfo.txt

# ---------- 构建产物 ----------
*.apk
*.aab
*.unitypackage
*.app
crashlytics-build.properties

# ---------- Addressables 打包产物 ----------
/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*

# ---------- Android 临时资源 ----------
/[Aa]ssets/[Ss]treamingAssets/aa.meta
/[Aa]ssets/[Ss]treamingAssets/aa/*

# ---------- 本地 AI 工具缓存（避免污染仓库）----------
.workbuddy-ai/
.claude/

# ---------- 诊断/截图临时文件（开发过程产物，不入库）----------
/workbuddy*.png
/workbuddy*.jpg

# ---------- 本地工具与运行时产物（可再生成，不入库）----------
/_scratch/
/add_lamps.txt
/Recordings/
/PerfLogs/twin-perf.csv

# ---------- P19 绑定/诊断报告（每次执行都会重写，不入库）----------
/p19_plan.txt
/p19_apply.txt
/p19_diag.txt
/p19_survey.txt
/p19_door.txt
/p19_doorfix.txt
/p19_door_runtime.txt

# P26 素材备份（不该进仓库，也不该进包体）
video/_backup/

# P26 素材源文件（转码后的成品在 Assets/StreamingAssets/PC/master/）
video/*.mp4

# Unity 目录监控临时文件（编辑器异常退出残留，不该进仓库）
~UnityDirMonSyncFile~*

# ---------- 施工期手工备份（.bak_*，不该进仓库也不该进包体）----------
*.bak_*
*.bak_*.meta

# ---------- 队员素材里的备份与构建日志（11-04 误入库后补规则）----------
# 文件名是 .bak.20261029_160008 这种「点分隔」，旧的 *.bak_* 只拦下划线分隔，漏了
*.bak.*
/Docs/**/backup/
unity_build.log

# ---------- P31 打包产物（11-05 新增）----------
# 二进制不进仓库：Builds/ 下是 ~1~2 GB 的 exe + Data，进库会直接把 clone 时间拉到不可用。
# 旧包 Docs/打包/ 是刻意保留的证据（F22 现场记录），不受本规则影响。
/Builds/

# ---------- 旧包证据（652MB，刻意保留在磁盘，但不进仓库）----------
# 21:52 首包的 F22 现场记录靠它复现，删了就没证据了；但 652MB 二进制进库不可接受。
/Docs/打包/

# ---------- D13 重打包旧包归档（11-12）----------
# 旧包是 D13 修复前唯一可作为 A/B 对照的实物，不可删；但它也不该进仓库。
# 注意：上面 /Builds/ 是精确匹配，改名后的目录不会自动被忽略，必须单独写。
/Builds_D13*/
