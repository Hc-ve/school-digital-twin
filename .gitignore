# ============================================================
# Unity 项目 .gitignore
# 项目：School（数字孪生底座）
# 说明：Library/ 达 1.3GB，必须排除；Assets 下的美术资源
#       不在此忽略，而是交给 Git LFS 管理（见 .gitattributes）
# ============================================================

# ---------- Unity 生成目录（绝不入库）----------
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/

# ---------- Asset Store 工具 ----------
/[Aa]ssets/AssetStoreTools*

# ---------- IDE / 编辑器缓存 ----------
.vs/
.idea/
.vscode/
.gradle/
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# ---------- Unity 生成的元文件 ----------
*.pidb.meta
*.pdb.meta
*.mdb.meta

# ---------- 崩溃报告 ----------
sysinfo.txt

# ---------- 构建产物 ----------
*.apk
*.aab
*.unitypackage
*.app
crashlytics-build.properties

# ---------- Addressables 打包产物 ----------
/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*

# ---------- Android 临时资源 ----------
/[Aa]ssets/[Ss]treamingAssets/aa.meta
/[Aa]ssets/[Ss]treamingAssets/aa/*

# ---------- 本地 AI 工具缓存（避免污染仓库）----------
.workbuddy-ai/
.claude/

# ---------- 诊断/截图临时文件（开发过程产物，不入库）----------
/workbuddy*.png
/workbuddy*.jpg

# ---------- 本地工具与运行时产物（可再生成，不入库）----------
/_scratch/
/add_lamps.txt
/Recordings/
/PerfLogs/twin-perf.csv

# ---------- P19 绑定/诊断报告（每次执行都会重写，不入库）----------
/p19_plan.txt
/p19_apply.txt
/p19_diag.txt
/p19_survey.txt
/p19_door.txt
/p19_doorfix.txt
/p19_door_runtime.txt

# P26 素材备份（不该进仓库，也不该进包体）
video/_backup/

# P26 素材源文件（转码后的成品在 Assets/StreamingAssets/PC/master/）
video/*.mp4

# Unity 目录监控临时文件（编辑器异常退出残留，不该进仓库）
~UnityDirMonSyncFile~*

# ---------- 施工期手工备份（.bak_*，不该进仓库也不该进包体）----------
*.bak_*
*.bak_*.meta
